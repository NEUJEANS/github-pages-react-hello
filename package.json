{
  "name": "github-pages-react-hello",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pages": "npm run build && node ./scripts/sync-dist-to-docs.mjs",
    "preview": "vite preview",
    "test": "node --test src/components/*.test.js server/*.test.js",
    "review:gemini": "bash ./scripts/gemini-review.sh",
    "smoke:auth": "node ./scripts/auth-login-smoke.mjs --require-browser",
    "smoke:auth:scaffold": "node ./scripts/auth-login-smoke.mjs",
    "smoke:auth:browser": "node ./scripts/auth-login-smoke.mjs --require-browser",
    "checkpoint:status": "git status --short --branch && echo '---' && git log --oneline --decorate -5",
    "security:secrets": "bash ./scripts/security-trufflehog.sh",
    "start:auth": "node server/auth-http-server.js --host 0.0.0.0 --port ${PORT:-4175}"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "cookie": "^1.1.1",
    "dotenv": "^17.4.2",
    "pino": "^10.3.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.59.1",
    "vite": "^7.1.0"
  }
}
