# HAVENLY auth server
HAVENLY_AUTH_SERVER_HOST=127.0.0.1
HAVENLY_AUTH_SERVER_PORT=4175
HAVENLY_AUTH_LOG_LEVEL=info

# Optional custom auth storage locations
# HAVENLY_AUTH_DATA_DIR=.data
# HAVENLY_AUTH_SQLITE_PATH=.data/havenly-auth-store.sqlite

# Frontend auth wiring (used by Vite at build/runtime)
# VITE_AUTH_API_BASE_URL=http://127.0.0.1:4175
# VITE_AUTH_LOGIN_ENDPOINT=/api/auth/login
# VITE_AUTH_SIGNUP_ENDPOINT=/api/auth/signup
# VITE_AUTH_SESSION_ENDPOINT=/api/auth/session
# VITE_AUTH_PENDING_ENDPOINT=/api/auth/pending
# VITE_AUTH_CONTINUE_ENDPOINT=/api/auth/continue
# VITE_AUTH_LOGOUT_ENDPOINT=/api/auth/logout
# VITE_AUTH_CREDENTIALS=include
